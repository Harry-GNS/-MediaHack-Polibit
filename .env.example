# Copia este archivo como .env. Nunca subas .env a Git.
# La clave es opcional para la validación: si no está disponible, el sistema
# usa un respaldo textual local. Es necesaria para extracción y respuestas IA.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# URL de la API compatible de OpenRouter.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
